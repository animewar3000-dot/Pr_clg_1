# CampusIQ Environment Configuration
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Required)
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side only - never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration (Optional)
# Supported: openai, anthropic
VITE_AI_PROVIDER=openai
# AI provider credentials and embedding keys belong in a server/edge-function runtime only.
# This repository does not yet contain a deployed AI function. Never use VITE_ for secrets.

# Application Configuration
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=CampusIQ

# Feature Flags (Optional - defaults shown)
# VITE_ENABLE_AI=false
# VITE_ENABLE_MARKETPLACE=true
# VITE_ENABLE_STUDY_GROUPS=true
